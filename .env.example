# =============================================================================
# HealthMind API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar a API.
# NUNCA comite o .env no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------

# Porta HTTP da API
PORT=3333

# Ambiente de execução: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------

# URL de conexão com o PostgreSQL principal.
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
#
# ✅ Fora do Docker (npm run dev direto na máquina):
#    O host é 'localhost' porque o banco roda na sua máquina.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthmind

# ✅ Dentro do Docker Compose (docker compose up):
#    O host é o nome do serviço definido no compose ('postgres').
#    O container da API enxerga o banco pelo nome de serviço, não por localhost.
#    DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthmind

# URL do banco de dados de testes (somente para ambiente de teste).
# Roda na porta 5433 para não conflitar com o banco principal.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/healthmind_test

# Credenciais do PostgreSQL — usadas pelo docker-compose.prod.yml.
# Em produção: use valores seguros e diferentes dos defaults abaixo.
# ⚠️  POSTGRES_PASSWORD é obrigatório no compose de produção (sem default).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=healthmind

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO JWT
# -----------------------------------------------------------------------------

# Chave secreta usada para assinar e verificar os tokens JWT.
# ⚠️ Em produção: use uma string longa, aleatória e única (mínimo 32 caracteres).
# Nunca use 'change_me' ou valores genéricos em produção.
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me

# Tempo de expiração do token JWT.
# Exemplos: 7d (7 dias), 1h (1 hora), 30m (30 minutos)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------

# Define quais origens podem acessar a API a partir de um navegador (browser).
#
# ℹ️  React Native (Expo mobile): CORS não se aplica.
#     Aplicativos mobile não são navegadores e não impõem a política de CORS.
#     O app faz requests diretos à API sem restrição de origem.
#
# ℹ️  Swagger UI (/docs): servido pelo próprio servidor, sem problema de CORS.
#
# Opções:
#
# ✅ Desenvolvimento / acesso aberto / mobile-only:
CORS_ORIGIN=*
#
# ✅ Frontend web em desenvolvimento (ex: Vite/React):
# CORS_ORIGIN=http://localhost:5173
#
# ✅ Produção com frontend web (URL exata):
# CORS_ORIGIN=https://app.healthmind.com.br
#
# ⚠️  Quando CORS_ORIGIN=*, a API reflete a origem da requisição ao invés de
#     responder com '*', mantendo compatibilidade com o header credentials.
#     Isso é seguro para APIs autenticadas via JWT (Authorization header).
#
# ⚠️  Para produção com frontend web público, prefira a URL exata do frontend.
